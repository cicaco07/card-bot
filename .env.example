DISCORD_TOKEN=isi_token_bot_discord_kamu

# Opsional. Jika diisi, slash command akan cepat muncul hanya di server ini.
# Kalau kosong, command disinkronkan global dan bisa butuh waktu sampai muncul.
DISCORD_GUILD_ID=

# Opsional untuk mode tournament Poker dan Rummy yang persistent.
# Gunakan PostgreSQL lokal atau direct/session-pooler connection string Supabase.
DATABASE_URL=postgresql+asyncpg://cardbot:cardbot@localhost:5432/cardbot

# Opsional. Jika kosong, migration memakai DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql+asyncpg://cardbot:cardbot@localhost:5432/cardbot
